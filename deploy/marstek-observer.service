[Unit]
Description=EnergyPi cost observation planner (no device commands)
After=marstek-battery.service

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/marstek-control
ExecStart=/home/pi/marstek-control/.venv/bin/python /home/pi/marstek-control/optimizer.py
TimeoutStartSec=180
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/marstek-control/data
# Planner only reads/writes SQLite; network access is not needed.
PrivateNetwork=true
