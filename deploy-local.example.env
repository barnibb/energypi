# Kopieren nach deploy-local.env und an das eigene Heimnetz anpassen.
ENERGYPI_TARGET="pi@RASPBERRY_PI_IP"
ENERGYPI_HOST="RASPBERRY_PI_IP"
ENERGYPI_REMOTE_DIR="/home/pi/marstek-control"
ENERGYPI_URL="http://RASPBERRY_PI_IP:8080"
# Optional bei der Umstellung von einem früheren persönlichen launchd-Namen.
ENERGYPI_LEGACY_LAUNCHD_LABEL=""
