[Unit]
Description=Archive old Shelly measurements and back up SQLite

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/marstek-control
ExecStart=/home/pi/marstek-control/.venv/bin/python /home/pi/marstek-control/maintenance.py
Environment=PYTHONUNBUFFERED=1
UMask=0077
Nice=10
TimeoutStartSec=30min
TimeoutStopSec=30s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/marstek-control/data
