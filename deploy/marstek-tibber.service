[Unit]
Description=Fetch published Tibber electricity prices
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/marstek-control
ExecStart=/home/pi/marstek-control/.venv/bin/python /home/pi/marstek-control/tibber.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/marstek-control/data
